# Karen2 Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=karen2
DB_PASSWORD=changeme
DB_NAME=karen2

# ============================================
# Redis Configuration (for caching)
# ============================================
#REDIS_HOST=localhost
#REDIS_PORT=6379
# REDIS_PASSWORD=optional-password

# ============================================
# JWT Configuration
# ============================================
# Generate a secure secret for production:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ============================================
# Email Configuration (SMTP)
# ============================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# FROM_EMAIL=noreply@karen2.local

# ============================================
# Application URL
# ============================================
# This is the URL where the app is accessed (used for emails, CORS, etc.)
# For Docker: http://localhost:8080 (or whatever APP_PORT is set to)
FRONTEND_URL=http://localhost:8080

# ============================================
# Docker Compose Ports (optional overrides)
# ============================================
# APP_PORT=8080        # Main application port (nginx serves both frontend and API)
# DB_PORT=5432         # PostgreSQL port (for external access)
# REDIS_PORT=6379      # Redis port (for external access)

# ============================================
# Environment
# ============================================
NODE_ENV=development
