# Frontend Environment Configuration
# Copy this file to .env.local for local development

# ============================================
# API URL Configuration
# ============================================
# For Docker deployment: DO NOT SET THIS (or comment it out)
# The frontend will use relative '/api' path which nginx proxies to the backend.
#
# For local development (bun run dev):
# VITE_API_URL=http://localhost:3000

# ============================================
# WebSocket URL Configuration
# ============================================
# For Docker deployment: DO NOT SET THIS (or comment it out)
# The frontend will use relative '/ws' path which nginx proxies to the backend.
#
# For local development (bun run dev):
# VITE_WS_URL=ws://localhost:3000/ws
